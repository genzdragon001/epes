# Environment / secrets
.env
.env.local
.env.*.local

# Dependencies
/vendor/
/node_modules/

# Logs
*.log
error_log
access_log

# Uploads (keep structure, ignore contents where appropriate)
uploads/
!uploads/.htaccess
!uploads/**/.gitkeep

# Backup files
backups/
!backups/.htaccess

# Large generated files
*.sql
all_source_files.txt
debug_log.txt
SUMMARY-SHEET-2025.xlsx
manuscript_text.txt
epes_db.sql
# BUT keep version-controlled migration scripts
!migrations/
!migrations/*.sql

# Design mockups / throwaway sketches (not part of the app)
sketches/

# Stray backup / demo files
*.bak
target_list_layout_demo.php

# Database folder (schema/migrations kept out of version control)
database/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# Generated temp files
*.tmp
*.cache

# Agent working dir
.hermes/
